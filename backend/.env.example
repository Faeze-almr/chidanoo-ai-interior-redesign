# Copy this file to .env and adjust as needed. Never commit the real .env file.

APP_NAME="CHIDANOO"
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Reserved/informational only - the device is auto-detected (torch.cuda.is_available()),
# matching the notebook's validated behavior.
DEVICE=cuda

# Optional: redirect Hugging Face model downloads to a specific directory.
# Leave unset to use huggingface_hub's own default cache location.
# MODEL_CACHE_DIR=

# JSON array of allowed frontend origins for CORS.
CORS_ORIGINS=["http://localhost:5173"]
